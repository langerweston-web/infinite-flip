{
  "name": "infinite-flip",
  "version": "1.0.0",
  "description": "Infinite Flip desktop game",
  "main": "main.js",
  "author": "langerweston-web",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.langerweston.infiniteflip",
    "productName": "Infinite Flip",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "infinite-flip.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
